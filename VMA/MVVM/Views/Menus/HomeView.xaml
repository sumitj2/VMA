<UserControl x:Class="VMA.MVVM.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VMA.MVVM.Views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:menus="clr-namespace:VMA.MVVM.ViewModels.Menus" xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" d:DataContext="{d:DesignInstance Type=menus:HomeViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="10"                    
 BorderThickness="0"
     Background="white" Opacity="0.95">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="120"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel>
                <WrapPanel HorizontalAlignment="Center">
                    <Border BorderBrush="White" BorderThickness="5" Margin="20 0" CornerRadius="15">
                        <materialDesign:Card  UniformCornerRadius="1" BorderThickness="5"
              BorderBrush="White" Width="148" Height="100"  Background="#F6F6F8">
                            <StackPanel Margin="5">
                                <materialDesign:PackIcon Kind="UserGroup">
                                    <materialDesign:PackIcon.Foreground>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0.5,1">
                                            <GradientStop Color="#912A73" Offset="0" />
                                            <GradientStop Color="#FA8E22" Offset="1" />
                                        </LinearGradientBrush>
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>
                                <TextBlock FontSize="12" Text="Total Vendors"  />
                                <TextBlock FontWeight="SemiBold" FontSize="25" Text="{Binding CountOfVendors ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 10 0 0" />

                            </StackPanel>
                        </materialDesign:Card>
                    </Border>
                    <Border BorderBrush="White" BorderThickness="5" Margin="20 0" CornerRadius="15">
                        <materialDesign:Card UniformCornerRadius="1" BorderThickness="5"
              BorderBrush="White" Width="148" Height="100"  Background="#F6F6F8">
                            <StackPanel Margin="5">
                                <materialDesign:PackIcon Kind="AccountService">
                                    <materialDesign:PackIcon.Foreground>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0.5,1">
                                            <GradientStop Color="#912A73" Offset="0" />
                                            <GradientStop Color="#FA8E22" Offset="1" />
                                        </LinearGradientBrush>
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>
                                <TextBlock FontSize="12" Text="Total Services" />
                                <TextBlock FontWeight="SemiBold" FontSize="25" Text="{Binding CountOfServices,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 10 0 0" />


                            </StackPanel>
                        </materialDesign:Card>
                    </Border>
                    <Border BorderBrush="White" BorderThickness="5" Margin="20 0" CornerRadius="15">
                        <materialDesign:Card UniformCornerRadius="1" BorderThickness="5"
               BorderBrush="White" Width="148" Height="100" Background="#F6F6F8">
                            <StackPanel Margin="5">
                                <materialDesign:PackIcon Kind="Rupee" Foreground="Red" />
                                <TextBlock FontSize="12" Text="Total Santioned Amount" />
                                <TextBlock FontWeight="SemiBold" FontSize="25" Text="{Binding TotalSanctionAmount,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 10 0 0" />



                            </StackPanel>
                        </materialDesign:Card>
                    </Border>
                    <Border BorderBrush="White" BorderThickness="5" Margin="20 0" CornerRadius="15">
                        <materialDesign:Card  UniformCornerRadius="1" BorderThickness="5"
            BorderBrush="White" Width="148" Height="100"   Background="#F6F6F8">
                            <StackPanel Margin="10">
                                <materialDesign:PackIcon Kind="AccountPending" Foreground="#29A3EC" />
                                <TextBlock FontSize="12" Text="Amount Paid" />
                                <TextBlock FontWeight="SemiBold" FontSize="25" Text="{Binding TotalPaidAmount ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 10 0 0" />

                            </StackPanel>
                        </materialDesign:Card>
                    </Border>
                </WrapPanel>
            </StackPanel>
            <Grid Grid.Row="1">

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="CompanyDetails" Grid.Row="0"
                                 Orientation="Vertical" Margin="20">

                        <TextBlock FontWeight="SemiBold" FontSize="25" Text="{Binding FinancialYear,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0" />

                        <lvc:PieChart Series="{Binding SeriesCollectionPieChart,UpdateSourceTrigger=PropertyChanged}" Width="275" Margin="0" Height="213">
                            <lvc:PieChart.ToolTip>
                                <ToolTip Content="{Binding DataContext.Formatter, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </lvc:PieChart.ToolTip>
                        </lvc:PieChart>


                    </StackPanel>

                    <StackPanel x:Name="CompanyDetail2" Grid.Column="1"
                                         Orientation="Vertical">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" Width="200" Margin="10" />
                            <lvc:CartesianChart Series="{Binding SeriesCollection, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Height="196" Width="380">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Title="" Labels="{Binding Labels}"></lvc:Axis>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="Amount" LabelFormatter="{Binding Formatter}"></lvc:Axis>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>
    </Border>
</UserControl>
