<UserControl x:Class="VMA.MVVM.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VMA.MVVM.Views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:menus="clr-namespace:VMA.MVVM.ViewModels.Menus" xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf" d:DataContext="{d:DesignInstance Type=menus:HomeViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="10"                    
 BorderThickness="0"
     Background="white" Opacity="0.95">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <WrapPanel HorizontalAlignment="Center" Margin="0 30 0 0 ">
                    <Border BorderBrush="White" BorderThickness="2" Margin="20 0" CornerRadius="5">
                        <materialDesign:Card VerticalContentAlignment="Center"
              BorderBrush="White" Width="148" Height="100"  Background="#F6F6F8">
                            <StackPanel Margin="5">
                                <materialDesign:PackIcon Kind="UserGroup" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon.Foreground>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0.5,1">
                                            <GradientStop Color="#912A73" Offset="0" />
                                            <GradientStop Color="#FA8E22" Offset="1" />
                                        </LinearGradientBrush>
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>
                                <TextBlock FontSize="12"  TextAlignment="Center" Text="Total Vendors"  />
                                <TextBlock FontWeight="SemiBold" FontSize="25" TextAlignment="Center" Text="{Binding CountOfVendors ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 0 0 0" />
                            </StackPanel>
                        </materialDesign:Card>
                    </Border>
                    <Border BorderBrush="White" BorderThickness="5" Margin="20 0" CornerRadius="15">
                        <materialDesign:Card UniformCornerRadius="1" BorderThickness="5"
              BorderBrush="White" Width="148" Height="100"  Background="#F6F6F8">
                            <StackPanel Margin="5">
                                <materialDesign:PackIcon Kind="AccountService" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon.Foreground>
                                        <LinearGradientBrush StartPoint="1,0" EndPoint="0.5,1">
                                            <GradientStop Color="#912A73" Offset="0" />
                                            <GradientStop Color="#FA8E22" Offset="1" />
                                        </LinearGradientBrush>
                                    </materialDesign:PackIcon.Foreground>
                                </materialDesign:PackIcon>
                                <TextBlock FontSize="12" TextAlignment="Center" Text="Total Services" />
                                <TextBlock FontWeight="SemiBold" FontSize="25" TextAlignment="Center"  Text="{Binding CountOfServices,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 0 0 0" />


                            </StackPanel>
                        </materialDesign:Card>
                    </Border>
                    <Border BorderBrush="White" BorderThickness="5" Margin="20 0" CornerRadius="15">
                        <materialDesign:Card UniformCornerRadius="1" BorderThickness="5" HorizontalAlignment="Center"
               BorderBrush="White" Width="148" Height="100" Background="#F6F6F8">
                            <StackPanel Margin="5" >
                                <materialDesign:PackIcon Kind="Rupee" Foreground="Red" HorizontalAlignment="Center" />
                                <TextBlock FontSize="12"  TextAlignment="Center" Text="Total Santioned Amount" />
                                <TextBlock FontWeight="SemiBold" FontSize="25" TextAlignment="Center"  Text="{Binding TotalSanctionAmount,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 0 0 0" />
                            </StackPanel>
                        </materialDesign:Card>
                    </Border>
                    <Border BorderBrush="White" BorderThickness="5" Margin="20 0" CornerRadius="15">
                        <materialDesign:Card  UniformCornerRadius="1" BorderThickness="5"
            BorderBrush="White" Width="148" Height="100"   Background="#F6F6F8">
                            <StackPanel Margin="10">
                                <materialDesign:PackIcon Kind="AccountPending" Foreground="#29A3EC" HorizontalAlignment="Center" />
                                <TextBlock FontSize="12"  TextAlignment="Center" Text="Amount Paid" />
                                <TextBlock FontWeight="SemiBold" FontSize="25"   TextAlignment="Center" Text="{Binding TotalPaidAmount ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="0 0 0 0" />

                            </StackPanel>
                        </materialDesign:Card>
                    </Border>
                </WrapPanel>
            </StackPanel>
            <Grid Grid.Row="1">

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="800"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="CompanyDetails" Grid.Row="0"
                                 Orientation="Vertical" Margin="20">

                        <TextBlock FontWeight="SemiBold" FontSize="25" Text="{Binding FyTitle,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Margin="40" />

                        <lvc:PieChart Series="{Binding SeriesCollectionPieChart,UpdateSourceTrigger=PropertyChanged}" Width="275" Margin="0" Height="213">
                            <lvc:PieChart.ToolTip>
                                <ToolTip Content="{Binding DataContext.Formatter, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </lvc:PieChart.ToolTip>
                        </lvc:PieChart>


                    </StackPanel>

                    <StackPanel x:Name="CompanyDetail2" Grid.Column="1"
                                         Orientation="Vertical" Margin="40">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Margin="40,20,20,-10">
                                <TextBlock FontWeight="SemiBold" FontSize="20"  Text="Select Service" Margin="0,10,20,-10" />
                                <ComboBox Style="{StaticResource vendorCombobox}" 
                                          ItemsSource="{Binding Services}" 
                                          SelectedItem="{Binding SelectedService}" Width="200" Margin="0,-10,20,10" />

                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <lvc:CartesianChart Series="{Binding SeriesCollectionForAmount, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Margin="10" Height="196" Width="250">
                                    <lvc:CartesianChart.AxisX >
                                        <lvc:Axis Title="Vendor Name" Labels="{Binding LabelsForAmount}"></lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY >
                                        <lvc:Axis Title="Amount" LabelFormatter="{Binding FormatterForAmount}"></lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                                <TextBlock FontWeight="SemiBold" FontSize="18"  Text="Payment Chart" Margin="-190,240,20,10" />


                                <lvc:CartesianChart Series="{Binding SeriesCollection}" Margin="10" Height="196" Width="250">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Vendor Name"  Labels="{Binding Labels}"></lvc:Axis>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY >
                                        <lvc:Axis Title="Tenure (months)"  LabelFormatter="{Binding Formatter}"></lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                                <TextBlock FontWeight="SemiBold" FontSize="18"  Text="Term Char" Margin="-190,240,20,10" />

                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                </Grid>

            </Grid>

        </Grid>
    </Border>
</UserControl>
