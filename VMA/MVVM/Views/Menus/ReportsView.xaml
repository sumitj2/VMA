<UserControl x:Class="VMA.MVVM.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VMA.MVVM.Views" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:menus="clr-namespace:VMA.MVVM.ViewModels.Menus" d:DataContext="{d:DesignInstance Type=menus:ReportsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="460" d:DesignWidth="800">
    <Border CornerRadius="10"                    
     BorderThickness="0"
         Background="white" Opacity="0.95">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="440"/>                
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TabControl Style="{DynamicResource TabContorlStyle}"  Background="White">                   

                    <TabItem Header="Service Payment Note" Style="{DynamicResource TabItemStyle}" Height="39">
                        <AdornerDecorator>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="400"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="CompanyDetails" Grid.Row="0"
                                            Orientation="Vertical">
                                    <TextBlock Text="Service Year"
                                               Style="{StaticResource FormTextBlock}"
                                               Margin="20,20,230,0"/>
                                    <TextBox x:Name="txtServiceYear"
                                             Text="{Binding VendorPaymentYear ,UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBox}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True" IsEnabled="False" />

                                    <TextBlock Text="Select Vendor"
                                               Style="{StaticResource FormTextBlock}"
                                               Margin="20,20,230,0"/>

                                    <ComboBox Style="{StaticResource vendorCombobox}"
                                              ItemsSource="{Binding VendorModels}"   
                                              SelectedItem="{Binding SelectedVendorModel, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                                              DisplayMemberPath="VendorName" 
                                              SelectedValuePath="VendorId"
                                              SelectedValue="{Binding SelectedVendorName, Mode=TwoWay}"
                                              Grid.Row="1" 
                                              Width="239" 
                                              Height="30" 
                                              VerticalContentAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Margin="0,-20,10,10"
                                              Background="Transparent"
                                              FontWeight="Medium"
                                              FontFamily="Montserrat"                            
                                              Foreground="{StaticResource plainTextColor3}"
                                              BorderBrush="{StaticResource plainTextColor3}"
                                              BorderThickness="0,0,0,1" />

                                    <TextBlock Text="Select Service"
                                               Style="{StaticResource FormTextBlock}"
                                               Margin="20,20,230,0"/>

                                    <ComboBox Style="{StaticResource vendorCombobox}"  
                                              ItemsSource="{Binding VendorServiceDetails}"   
                                              SelectedItem="{Binding SelectedVendorDetailService, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                                              DisplayMemberPath="VendorServiceName" 
                                              SelectedValuePath="VendorServiceId"
                                              SelectedValue="{Binding SelctedVendorServiceName, Mode=TwoWay}"
                                              Grid.Row="1" 
                                              Width="239" 
                                              Height="30" 
                                              VerticalContentAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Margin="0,-20,10,10"
                                              Background="Transparent"
                                              FontWeight="Medium"
                                              FontFamily="Montserrat"                            
                                              Foreground="{StaticResource plainTextColor3}"
                                              BorderBrush="{StaticResource plainTextColor3}"
                                              BorderThickness="0,0,0,1" />

                                    <TextBlock Text="From"
                                               Style="{StaticResource FormTextBlock}"/>
                                    <TextBox x:Name="txtServiceYe"
                                             Text="{Binding From ,UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBox}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             Width="302" 
                                             Margin="10,-20,-30,30"/>

                                    <TextBlock Text="To"
                                               Style="{StaticResource FormTextBlock}"/>

                                    <TextBox x:Name="txtServiceYea"
                                             Text="{Binding To ,UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBox}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True" Width="302" 
                                             Margin="10,-20,-30,45" />
                                   
                                    <Button Style="{StaticResource vendorSaveButton}"
                                            HorizontalAlignment="Right"
                                            Command="{Binding GenerateCommand}"                            
                                            Content="Generate"                            
                                            FontSize="12"
                                            FontFamily="Montserrat"
                                            Cursor="Hand"
                                            BorderThickness="0"
                                            Foreground="White"
                                            VerticalAlignment="Top"
                                            Margin="0,-8,20,0"/>


                                </StackPanel>

                                <StackPanel x:Name="CompanyDetail2" Grid.Column="1"
                                            Orientation="Vertical">

                                    <TextBlock Text="Note Generation Date"
                                               Style="{StaticResource FormTextBlock}"
                                               Margin="20,20,230,0"/>

                                    <DatePicker x:Name="txtserviceStartDate"
                                                Text="{Binding NoteGenerationDate ,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Width="361" />

                                    <TextBlock Text="Body Befor Invoice"
                                               Style="{StaticResource FormTextBlock}"/>
                                    <TextBox Text="{Binding BeforeInvocie, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Visible"
                                             HorizontalScrollBarVisibility="Visible"
                                             Margin="10"
                                             TextWrapping="Wrap" Width="344" Height="102"/>

                                    <TextBlock Text="Body After Invoice"
                                               Style="{StaticResource FormTextBlock}"/>
                                    <TextBox Text="{Binding AfterInvoice, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Visible"
                                             HorizontalScrollBarVisibility="Visible"
                                             Margin="10"
                                             TextWrapping="Wrap" Width="344" Height="72" />

                                    <Button Style="{StaticResource vendorClearButton}"
                                            Command="{Binding ClearFormCommand }"                            
                                            Content="Clear"                            
                                            FontSize="12"
                                            FontFamily="Montserrat"
                                            Cursor="Hand"
                                            BorderThickness="0"
                                            Foreground="White"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>

                            </Grid>
                            
                        </AdornerDecorator>
                        
                    </TabItem>

                    <TabItem Header="Report" Style="{DynamicResource TabItemStyle}" Height="39">
                        <AdornerDecorator>
                            <StackPanel Grid.Row="2" 
                                        Orientation="Vertical"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,9">
                                <Button Style="{StaticResource RepotItemsButton}"
                                        Command="{Binding ExportPaymentNoteCommand}"                            
                                        Content="AMC Excel Report"                            
                                        FontSize="12"
                                        FontFamily="Montserrat"
                                        Cursor="Hand"
                                        BorderThickness="2"
                                        Foreground="White"
                                        VerticalAlignment="Top"/>

                                <Button Style="{StaticResource RepotItemsButton}"
                                        Command="{Binding MonthlyReportCommand}"                            
                                        Content="Monthly PDF Report"                            
                                        FontSize="12"
                                        FontFamily="Montserrat"
                                        Cursor="Hand"
                                        BorderThickness="2"
                                        Foreground="White"
                                        VerticalAlignment="Top"/>

                                <Button Style="{StaticResource RepotItemsButton}"
                                        Command="{Binding YearlyReportCommand}"                            
                                        Content="Yearly PDF Report"                            
                                        FontSize="12"
                                        FontFamily="Montserrat"
                                        Cursor="Hand"
                                        BorderThickness="2"
                                        Foreground="White"
                                        VerticalAlignment="Top"/>

                            </StackPanel>
                        </AdornerDecorator>
                    </TabItem>
                </TabControl>

            </Grid>

           
        </Grid>
    </Border>
</UserControl>
