<UserControl x:Class="VMA.MVVM.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VMA.MVVM.Views" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:menus="clr-namespace:VMA.MVVM.ViewModels.Menus" d:DataContext="{d:DesignInstance Type=menus:SettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="10"                    
BorderThickness="0"
    Background="white" Opacity="0.95">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="410"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TabControl Style="{DynamicResource TabContorlStyle}" Background="White">
                    <TabItem Header="General Settings" Style="{DynamicResource TabItemStyle}" Height="39">
                        <AdornerDecorator>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="400"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="CompanyDetails" Grid.Row="0"
                                Orientation="Vertical">

                                    <TextBlock Text="Enter Financial Year"
                                           Style="{StaticResource FormTextBlock}"/>

                                    <TextBox x:Name="txtFinancilaYear"
                                         Text="{Binding FinancialYear ,UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" Width="238" Margin="-90,10,20,10"/>
                                    <Button Style="{StaticResource vendorSaveButton}"
                                            Command="{Binding SubmitFinancialYearCommand}"                            
                                            Content="Year"                            
                                            FontSize="12"
                                            FontFamily="Montserrat"
                                            Cursor="Hand"
                                            BorderThickness="0"
                                            Foreground="White"
                                            VerticalAlignment="Top"
                                            Margin="280,-40,20,30" />
                                    <TextBlock Text="Enter Note ID"
                                           Style="{StaticResource FormTextBlock}"/>

                                    <TextBox x:Name="txtNoteId"
                                         Text="{Binding NoteId ,UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                          Width="238" Margin="-90,10,20,10"/>
                                    <Button Style="{StaticResource vendorSaveButton}"
                                            Command="{Binding SubmitNoteIdCommand}"                            
                                            Content="NoteId"                            
                                            FontSize="12"
                                            FontFamily="Montserrat"
                                            Cursor="Hand"
                                            BorderThickness="0"
                                            Foreground="White"
                                            VerticalAlignment="Top"
                                            Margin="280,-40,20,30"/>

                                    <StackPanel Grid.Row="2" 
                                                Orientation="Horizontal"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,9">

                                       
                                    </StackPanel>

                                </StackPanel>

                                <StackPanel Grid.Column="2" >
                                    <TextBlock Text="Storage Location for Excel"     Style="{StaticResource FormTextBlock}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding FilePathExcel, UpdateSourceTrigger=PropertyChanged}" Width="212" Margin="10,20,150,10"/>
                                    <Button Style="{StaticResource vendorSaveButton}" Command="{Binding BrowseExcelLocationCommand}" Content="Browse" Width="100" Margin="10,-50,-250,0"/>

                                    <TextBlock Text="Storage Location for Word"     Style="{StaticResource FormTextBlock}"/>
                                    <TextBox Style="{StaticResource FormTextBox}" Text="{Binding FilePathWord, UpdateSourceTrigger=PropertyChanged}" Width="218" Margin="10,20,150,10"/>
                                    <Button Style="{StaticResource vendorSaveButton}" Command="{Binding BrowseWordLocationCommand}" Content="Browse" Width="100" Margin="10,-50,-250,0"/>

                                </StackPanel>

                            </Grid>

                        </AdornerDecorator>

                    </TabItem>

                    <TabItem Header="Settings" Style="{DynamicResource TabItemStyle}" Height="39">
                        <AdornerDecorator>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <GroupBox Header="Departments" FontSize="15" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" Grid.Column="0" BorderThickness="2" Height="300">

                                    <StackPanel x:Name="CompanyDetail2" Orientation="Vertical" MouseLeftButtonDown="GroupBox_MouseLeftButtonDown">
                                        <DockPanel>
                                            <TextBox x:Name="inputTextBox" Style="{StaticResource FormTextBox}" Text="{Binding NeworExistingDepartment,UpdateSourceTrigger=PropertyChanged}" Width="200" Height="25"/>
                                            <TextBlock IsHitTestVisible="False" Text="Enter Department" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-220 0 0 0"  
                                                       Foreground="{StaticResource plainTextColor3}"
                                                       FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=inputTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="{Binding BtnDepartmentContent}" Width="100" Command="{Binding AddOrUpdateDepartment}" Style="{StaticResource vendorAddButton}"/>
                                        </DockPanel>
                                        <Separator Background="LightGray" Height="5" Margin="0 10 0 0"/>
                                        <StackPanel Background="White" MouseLeftButtonDown="GroupBox_MouseLeftButtonDown" Orientation="Vertical" >
                                            <TextBlock Text="Available Departments" Foreground="Black" FontSize="12" FontWeight="Medium" HorizontalAlignment="Left" Margin="20 5 0 0"/>
                                            <ListBox x:Name="itemsListBox" Background="Transparent" Width="200" Height="200" HorizontalAlignment="Left" BorderThickness="0" Margin="25 0 0 0" ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel IsItemsHost="True" Orientation="Vertical"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="10*"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="10*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="1"
TextAlignment="Center" VerticalAlignment="Center" Margin="5 0 0 0" TextWrapping="Wrap" 
Text="{Binding DepartmentName,UpdateSourceTrigger=PropertyChanged}" FontSize="14" Foreground="Black" HorizontalAlignment="Left" Background="Transparent" />

                                                            <Button  Grid.Column="2" Margin="5 3 0 0" Height="20" Width="20" MinHeight="20" MinWidth="20" BorderBrush="{x:Null}" Background="Transparent" BorderThickness="0"
                     Command="{Binding DataContext.DeleteDepartmentCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                     VerticalAlignment="Center" HorizontalAlignment="Center" CommandParameter="{Binding}">
                                                                <iconPacks:PackIconMaterial Kind="Delete" Width="12" Height="12" VerticalAlignment="Center" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Sanctions" FontSize="15" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" Grid.Column="1" BorderThickness="2" Height="300">

                                    <StackPanel x:Name="Sanctions" Orientation="Vertical" MouseLeftButtonDown="SactionsGroupBox_MouseLeftButtonDown">
                                        <DockPanel>
                                            <TextBox x:Name="inputSanctions" Style="{StaticResource FormTextBox}" Text="{Binding NeworExistingSanction,UpdateSourceTrigger=PropertyChanged}" Width="200" Height="25"/>
                                            <TextBlock IsHitTestVisible="False" Text="Enter Sanction" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-220 0 0 0"  
Foreground="{StaticResource plainTextColor3}"
FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=inputSanctions}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="{Binding BtnSanctionContent}" Width="100" Command="{Binding AddOrUpdateSanction}" Style="{StaticResource vendorAddButton}"/>
                                        </DockPanel>
                                        <Separator Background="LightGray" Height="5" Margin="0 10 0 0"/>
                                        <StackPanel Background="White" MouseLeftButtonDown="SactionsGroupBox_MouseLeftButtonDown">
                                            <TextBlock Text="Available Sanctions" Foreground="Black" FontSize="12" FontWeight="Medium" HorizontalAlignment="Left" Margin="20 5 0 0"/>

                                            <ListBox x:Name="itemsSanctionsListBox" Width="200" Height="200" BorderThickness="0" HorizontalAlignment="Left" Margin="25 0 0 0" ItemsSource="{Binding Sanctions}" SelectedItem="{Binding SelectedSanction}">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel IsItemsHost="True" Orientation="Vertical"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="10*"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="10*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="1"
TextAlignment="Center" VerticalAlignment="Center" Margin="5 0 0 0" TextWrapping="Wrap" 
Text="{Binding SanctionName,UpdateSourceTrigger=PropertyChanged}" FontSize="14" Foreground="Black" HorizontalAlignment="Left" Background="Transparent" />

                                                            <Button  Grid.Column="2" Margin="5 3 0 0" Height="20" Width="20" MinHeight="20" MinWidth="20" BorderBrush="{x:Null}" Background="Transparent" BorderThickness="0"
                     Command="{Binding DataContext.DeleteSanctionCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                     VerticalAlignment="Center" HorizontalAlignment="Center" CommandParameter="{Binding}">
                                                                <iconPacks:PackIconMaterial Kind="Delete" Width="12" Height="12" VerticalAlignment="Center" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Expenditure" FontSize="15" FontWeight="Medium" FontFamily="Montserrat" Foreground="Black" Grid.Column="2" BorderThickness="2" Height="300">

                                    <StackPanel x:Name="Expenditure" Orientation="Vertical" MouseLeftButtonDown="ExpenditureGroupBox_MouseLeftButtonDown">
                                        <DockPanel>
                                            <TextBox x:Name="inputExpenditure" Style="{StaticResource FormTextBox}" Text="{Binding NeworExistingExpenditure,UpdateSourceTrigger=PropertyChanged}" Width="200" Height="25"/>
                                            <TextBlock IsHitTestVisible="False" Text="Enter Expenditure" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-220 0 0 0"  
Foreground="{StaticResource plainTextColor3}"
FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=inputExpenditure}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="{Binding BtnExpenditureContent}" Width="100" Command="{Binding AddOrUpdateExpenditure}" Style="{StaticResource vendorAddButton}"/>
                                        </DockPanel>
                                        <Separator Background="LightGray" Height="5" Margin="0 10 0 0"/>
                                        <StackPanel Background="White" MouseLeftButtonDown="ExpenditureGroupBox_MouseLeftButtonDown">
                                            <TextBlock Text="Available Expenditure" Foreground="Black" FontSize="12" FontWeight="Medium" HorizontalAlignment="Left" Margin="20 5 0 0"/>

                                            <ListBox x:Name="itemsExpenditureListBox" Width="200" Height="200" BorderThickness="0" HorizontalAlignment="Left" Margin="25 0 0 0" ItemsSource="{Binding Expenditures}" SelectedItem="{Binding SelectedExpentidure}">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel IsItemsHost="True" Orientation="Vertical"/>
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="10*"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="10*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="1"
TextAlignment="Center" VerticalAlignment="Center" Margin="5 0 0 0" TextWrapping="Wrap" 
Text="{Binding ExpenditureName,UpdateSourceTrigger=PropertyChanged}" FontSize="14" Foreground="Black" HorizontalAlignment="Left" Background="Transparent" />

                                                            <Button  Grid.Column="2" Margin="5 3 0 0" Height="20" Width="20" MinHeight="20" MinWidth="20" BorderBrush="{x:Null}" Background="Transparent" BorderThickness="0"
                     Command="{Binding DataContext.DeleteExpenditureCommand,RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                     VerticalAlignment="Center" HorizontalAlignment="Center" CommandParameter="{Binding}">
                                                                <iconPacks:PackIconMaterial Kind="Delete" Width="12" Height="12" VerticalAlignment="Center" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </AdornerDecorator>
                    </TabItem>

                </TabControl>
            </Grid>

            <!--buttons setting in footer-->
            <StackPanel Grid.Row="2" 
                Orientation="Horizontal"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,9">

                <!--<Button Style="{StaticResource vendorSaveButton}"
                        Command="{Binding SubmitCommand}"                            
                        Content="Save"                            
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        BorderThickness="0"
                        Foreground="White"
                        VerticalAlignment="Top"/>-->
                <!--<Button Style="{StaticResource vendorCancelButton}"
                        Command="{Binding HideDetailInfoFormCommand}"                            
                        Content="Cancel"                            
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        BorderThickness="0"
                        Foreground="White"
                        VerticalAlignment="Top"/>
                <Button Style="{StaticResource vendorClearButton}"
                        Command="{Binding ClearFormCommand }"                            
                        Content="Clear"                            
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        BorderThickness="0"
                        Foreground="White"
                        VerticalAlignment="Top"/>-->


            </StackPanel>
        </Grid>
    </Border>
</UserControl>
