<UserControl x:Class="VMA.MVVM.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VMA.MVVM.Views" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:menus="clr-namespace:VMA.MVVM.ViewModels.Menus" d:DataContext="{d:DesignInstance Type=menus:SettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="10"                    
BorderThickness="0"
    Background="white" Opacity="0.95">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="410"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TabControl Style="{DynamicResource TabContorlStyle}"  Background="White">
                    <TabItem Header="GST Settings" Style="{DynamicResource TabItemStyle}" Height="39">
                        <AdornerDecorator>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="400"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="CompanyDetails" Grid.Row="0"
                                Orientation="Vertical">
                                   
                                    <TextBlock Text="Enter CGST Percentage"
                                           Style="{StaticResource FormTextBlock}"/>

                                    <TextBox x:Name="txtCGST"
                                         Text="{Binding Cgstpercentage ,UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"/>
                                    <TextBlock Text="Enter SGST Percentage"
                                           Style="{StaticResource FormTextBlock}"/>

                                    <TextBox x:Name="txtSGST"
                                         Text="{Binding Sgstpercentage ,UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"/>

                                    <TextBlock Text="Enter IGST Percentage"
                                               Style="{StaticResource FormTextBlock}"/>

                                    <TextBox x:Name="txtIGST"
                                             Text="{Binding Igstpercentage ,UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBox}"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"/>

                                </StackPanel>

                                <StackPanel x:Name="CompanyDetail2" Grid.Column="1"
                                   Orientation="Vertical">
                                    
                                </StackPanel>

                            </Grid>
                        </AdornerDecorator>
                    </TabItem>

                    
                </TabControl>
            </Grid>

            <!--buttons setting in footer-->
            <StackPanel Grid.Row="2" 
                Orientation="Horizontal"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,9">
               
                <Button Style="{StaticResource vendorSaveButton}"
                        Command="{Binding SubmitCommand}"                            
                        Content="Save"                            
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        BorderThickness="0"
                        Foreground="White"
                        VerticalAlignment="Top"/>
                <!--<Button Style="{StaticResource vendorCancelButton}"
                        Command="{Binding HideDetailInfoFormCommand}"                            
                        Content="Cancel"                            
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        BorderThickness="0"
                        Foreground="White"
                        VerticalAlignment="Top"/>
                <Button Style="{StaticResource vendorClearButton}"
                        Command="{Binding ClearFormCommand }"                            
                        Content="Clear"                            
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        BorderThickness="0"
                        Foreground="White"
                        VerticalAlignment="Top"/>-->
                

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
