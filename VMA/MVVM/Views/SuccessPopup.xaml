<UserControl x:Class="VMA.MVVM.Views.SuccessPopup"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:viewmodels="clr-namespace:VMA.MVVM.ViewModels" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" d:DataContext="{d:DesignInstance Type=viewmodels:SuccessPopupViewModel}"
             Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Grid Background="#80000000">
        <Border Background="White" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding Message}" FontSize="16" Margin="0,0,0,10" TextAlignment="Center"/>
                <Image Source="{Binding GifSource}" Width="100" Height="100" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>