<Window x:Class="VMA.MVVM.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:local="clr-namespace:VMA.MVVM.Views" 
        xmlns:viewModel="clr-namespace:VMA.MVVM.ViewModels.Menus" 
        xmlns:viewmodels="clr-namespace:VMA.MVVM.ViewModels"
        xmlns:viewModelAdd="clr-namespace:VMA.MVVM.ViewModels.Add"
        xmlns:addViews="clr-namespace:VMA.MVVM.Views.Add" xmlns:local1="clr-namespace:VMA.MVVM.Views.Menus"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="MainWindowView" Height="720" Width="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Icon="/Images/logo.png"
        Background="Transparent"
        AllowsTransparency="True">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModel:HomeViewModel}">
            <local:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:VendorViewModel}">
            <local:VendorsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:ProductServicesViewModel}">
            <local:ProductServices/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:DetailedInfoViewModel}">
            <local:DetailedInfoView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:PaymentsViewModel}">
            <local:PaymentView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:PaymentNotesViewModel}">
            <local:PaymentNotesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:ReportsViewModel}">
            <local:ReportsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:SettingsViewModel}">
            <local:SettingsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModelAdd:AddUpdateVendorViewModel}">
            <addViews:AddUpdateVendorView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModelAdd:AddProductServicesViewModel}">
            <addViews:AddUpdateProductServicesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModelAdd:AddPaymentsViewModel}">
            <addViews:AddUpdatePaymentsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModelAdd:AddDetailedInfoViewModel}">
            <addViews:AddUpdateDetailedInfoView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModelAdd:AddPaymentNotesViewModel}">
            <addViews:AddUpdatePaymentNotesView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:GSTViewModel}">
            <local1:GSTView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModelAdd:AddUpdateGSTMasterViewModel}">
            <addViews:AddUpdateGSTMaster/>

        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="10"                    
            BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.ColumnDefinitions>
                <!--Navigation menu-->
                <ColumnDefinition Width="260"/>
                <!--Content section-->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--Navigation Menu-->
            <Border CornerRadius="10,0,0,10"
                    Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                        <GradientStop Color="{StaticResource secondaryBackColor1}" Offset="0"/>
                        <GradientStop Color="{StaticResource secondaryBackColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>

                    <!--Logo-->
                    <StackPanel Orientation="Horizontal"
                                Height="180"
                                Margin="0,5,0,10">

                        <Image Source="/Images/Logo.png" Height="172" Width="254"/>

                    </StackPanel>


                    <!--Menu Buttons-->
                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color1}"
                                 IsChecked="True"
                                 Command="{Binding ShowHomeViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Home" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Home" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color3}"
                                 Command="{Binding ShowVendorViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="UserGroup" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Vendors" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color4}"
                                 Command="{Binding ShowProductServicesViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="ProductHunt" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Products Services" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color5}"
                                 Command="{Binding ShowDetailedInfoViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="InfoCircle" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Detailed Info" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color7}"
                                 Command="{Binding ShowPaymentNoteViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="NoteSticky" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Payment Notes" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color6}"
                                 Command="{Binding ShowPaymentViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Paypal" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Payments" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>



                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color8}"
                                 Command="{Binding ShowReportViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="File" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Reports" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color8}"
                                 Command="{Binding ShowGSTViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="RankingStar" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="GST Master" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource menuButton}"
                                 Tag="{StaticResource color9}"
                                 Command="{Binding ShowSettingViewCommand}">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconImage Icon="Gears" Style="{StaticResource menuButtonIcon}"/>
                            <TextBlock Text="Settings" Style="{StaticResource menuButtonText}"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>
            </Border>
            <!--Main Section-->
            <Border CornerRadius="0,10,10,0" Grid.Column="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0"/>
                        <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <!--Control bar-->
                        <RowDefinition Height="35"/>
                        <!--Header / Caption-->
                        <RowDefinition Height="45"/>
                        <!--Content section / Child views-->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--Control bar-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <StackPanel x:Name="pnlControlBar"
                                Grid.Row="0"
                                Orientation="Horizontal"
                                FlowDirection="RightToLeft"
                                Background="Transparent"
                                MouseLeftButtonDown="PnlControlBar_MouseLeftButtonDown"
                                MouseEnter="PnlControlBar_MouseEnter">
                        
                        <Button x:Name="btnClose"
                                Style="{StaticResource controlButton}"
                                Tag="{ StaticResource color4 }"
                                Click="BtnClose_Click">
                            <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"></fa:IconImage>
                        </Button>

                        <Button x:Name="btnMaximize"
                                Style="{StaticResource controlButton}"
                                Tag="{ StaticResource color6 }"
                                Click="BtnMaximize_Click">
                            <fa:IconImage Icon="Square" Style="{StaticResource controlButtonIcon}"></fa:IconImage>
                        </Button>

                        <Button x:Name="btnMinimize"
                                Style="{StaticResource controlButton}"
                                Tag="{ StaticResource color8 }"
                                Click="BtnMinimize_Click">
                            <fa:IconImage Icon="WindowMinimize" Style="{StaticResource controlButtonIcon}"></fa:IconImage>
                        </Button>
                       
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="Vendor Management Application"
                                   Foreground="White"
                                   FontWeight="Medium"
                                   FontSize="15"
                                   FontFamily="Montserrat"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!--header/caption-->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="43*"></ColumnDefinition>
                            <ColumnDefinition Width="555*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center" Grid.ColumnSpan="2" >
                            <fa:IconImage Icon="{Binding Icon}"
                                          Height="20"
                                          Width="20"
                                          Foreground="{StaticResource titleColor2}"
                                          Margin="35,0,10,0"/>
                            <TextBlock Text="{Binding Caption}"
                                       Foreground="{StaticResource titleColor2}"
                                       FontSize="16"
                                       FontFamily="Montserrat"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!--user option-->
                        <StackPanel
                                    Orientation="Horizontal"
                                    FlowDirection="RightToLeft"
                                    VerticalAlignment="Center"
                                    Margin="0,0,10,0" Grid.ColumnSpan="2">
                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color1}">
                                <fa:IconImage Icon="AngleDown" Style="{StaticResource iconButtonIcon }"/>
                            </Button>
                            <TextBlock Text="{Binding CurrentUserAccount.Username}"
                                       Foreground="{StaticResource titleColor3}"
                                       FontSize="12"
                                       FontFamily="Montserrat"
                                       VerticalAlignment="Center"/>
                            <Ellipse Height="35" Width="35"
                                     Stroke="{StaticResource color2}"
                                     StrokeThickness="2"
                                     Margin="10,0,10,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="/Images/user-icon.png"></ImageBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Button Style="{StaticResource iconButton}"
                                    Tag="{StaticResource color1}">
                                <fa:IconImage Icon="Bell" Style="{StaticResource iconButtonIcon }"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--content section /child sectin-->
                    <ContentControl Content="{Binding CurrentChildView}"
                                    Grid.Row="2"
                                    Margin="25"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
