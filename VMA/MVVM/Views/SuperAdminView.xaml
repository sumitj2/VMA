<Window x:Class="VMA.MVVM.Views.SuperAdminView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VMA.MVVM.Views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp" xmlns:viewmodels="clr-namespace:VMA.MVVM.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SuperAdminViewModel}"
        mc:Ignorable="d"
        Title="SuperAdminView" Height="520" Width="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" Icon="/Images/logo.png"
        Background="Transparent"
        AllowsTransparency="True">
    
    <Border CornerRadius="10"                    
        BorderThickness="1">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>

            <!--Navigation Menu-->
            <!--Main Section-->
            <Border CornerRadius="10,10,10,10" Grid.ColumnSpan="2" Margin="0,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                        <GradientStop Color="{StaticResource primaryBackColor1}" Offset="0"/>
                        <GradientStop Color="{StaticResource primaryBackColor2}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <!--Control bar-->
                        <RowDefinition Height="35"/>
                        <!--Header / Caption-->
                        <RowDefinition Height="240"/>
                        <!--Content section / Child views-->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--Control bar-->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <StackPanel x:Name="pnlControlBar"
                         Grid.Row="0"
                         Orientation="Horizontal"
                         FlowDirection="RightToLeft"
                         Background="Transparent"
                         MouseLeftButtonDown="PnlControlBar_MouseLeftButtonDown"
                         MouseEnter="PnlControlBar_MouseEnter">

                        <Button x:Name="btnClose"
                         Style="{StaticResource controlButton}"
                         Tag="{ StaticResource color4 }"
                         Click="BtnClose_Click">
                            <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"></fa:IconImage>
                        </Button>

                        <Button x:Name="btnMaximize"
                         Style="{StaticResource controlButton}"
                         Tag="{ StaticResource color6 }"
                         Click="BtnMaximize_Click">
                            <fa:IconImage Icon="Square" Style="{StaticResource controlButtonIcon}"></fa:IconImage>
                        </Button>

                        <Button x:Name="btnMinimize"
                         Style="{StaticResource controlButton}"
                         Tag="{ StaticResource color8 }"
                         Click="BtnMinimize_Click">
                            <fa:IconImage Icon="WindowMinimize" Style="{StaticResource controlButtonIcon}"></fa:IconImage>
                        </Button>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="User Creation"
                            Foreground="White"
                            FontWeight="Medium"
                            FontSize="18"
                            FontFamily="Montserrat"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Margin="10,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!--header/caption-->
                    <Grid Grid.Row="1" Background="White">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="200"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="39"/>
                                            <ColumnDefinition Width="361"/>
                                            <ColumnDefinition Width="400"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel x:Name="CompanyDetails"
                                                Orientation="Vertical" 
                                                VerticalAlignment="Center" Grid.ColumnSpan="2">


                                            <TextBlock Text="User Name"
                                                   Style="{StaticResource FormTextBlock}"/>

                                            <TextBox x:Name="txtSGST"
                                                 Text="{Binding UserName ,UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"/>

                                            <TextBlock Text="Password"
                                                   Style="{StaticResource FormTextBlock}"/>

                                            <TextBox x:Name="txtIGST"
                                                 Text="{Binding Password ,UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FormTextBox}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"/>

                                        </StackPanel>
                                        <StackPanel x:Name="CompanyDetails2" Grid.Column="2"
                                                Orientation="Vertical" 
                                                VerticalAlignment="Center">

                                            <TextBlock Text="First Name"
                                                       Style="{StaticResource FormTextBlock}"/>

                                            <TextBox x:Name="txtFirstName"
                                                     Text="{Binding FirstName ,UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBox}"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"/>

                                            <TextBlock Text="Last Name"
                                                       Style="{StaticResource FormTextBlock}"/>

                                            <TextBox x:Name="txtLastName"
                                                     Text="{Binding LastName ,UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBox}"                                                     
                                                     AcceptsReturn="True"/>
                                            <TextBlock Text="Email Id"
                                                       Style="{StaticResource FormTextBlock}"/>

                                            <TextBox x:Name="txtEmailId"
                                                     Text="{Binding EmailId ,UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FormTextBox}"                                                     
                                                     AcceptsReturn="True"/>

                                        </StackPanel>

                                        <StackPanel x:Name="CompanyDetail2" Grid.Column="2"
                                                    Orientation="Vertical">

                                        </StackPanel>

                                    </Grid>

                                </Grid>

                                <!--buttons setting in footer-->
                                <StackPanel Grid.Row="2" 
                                        Orientation="Horizontal"
                                        VerticalAlignment="Bottom"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,10">

                                    <Button Style="{StaticResource vendorSaveButton}"
                                        Command="{Binding SubmitCommand}"                            
                                        Content="Save"                            
                                        FontSize="12"
                                        FontFamily="Montserrat"
                                        Cursor="Hand"
                                        BorderThickness="0"
                                        Foreground="White"
                                        VerticalAlignment="Top" Margin="10"/>


                                </StackPanel>
                            </Grid>
                        </StackPanel>

                    </Grid>
                    <Grid Grid.Row="2" Background="White">


                        <DataGrid 
                            Style="{DynamicResource DataGridStyle1}" 
                            CellStyle="{DynamicResource DataGridCellStyle1}" 
                            ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" 
                            RowStyle="{DynamicResource DataGridRowStyle1}" 
                            ItemsSource="{Binding UserModels,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" AutoGenerateColumns="False" CanUserResizeRows="False" ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="User Name" Binding="{Binding Username}" IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="First Name" Binding="{Binding Name}" IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" IsReadOnly="True" Width="auto"/>
                                <DataGridTextColumn Header="Email Id" Binding="{Binding Email}" IsReadOnly="True" Width="auto"/>
                                <!--<DataGridTemplateColumn Header="Operations" IsReadOnly="True" Width="auto">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        -->
                                <!--<Button Style="{StaticResource gridEditButton}" Command="{Binding DataContext.EditVendorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" >
                            <iconPacks:PackIconMaterial Kind="PencilOutline" Width="12" Height="12" VerticalAlignment="Center" />
                        </Button>-->
                                <!--<Button Style="{StaticResource gridRemoveButton}">
                    <iconPacks:PackIconMaterial Kind="DeleteOutline" Width="12" Height="12" VerticalAlignment="Center"  />
                </Button>-->
                                <!--
                    </StackPanel>

                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>-->

                            </DataGrid.Columns>
                        </DataGrid>

                    </Grid>

                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
