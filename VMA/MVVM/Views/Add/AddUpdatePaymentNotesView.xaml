<UserControl x:Class="VMA.MVVM.Views.Add.AddUpdatePaymentNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:add="clr-namespace:VMA.MVVM.ViewModels.Add" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="10"                    
    BorderThickness="0"
        Background="white" Opacity="0.95">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="410"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TabControl Style="{DynamicResource TabContorlStyle}" SelectedIndex="{Binding SelectedTabIndex}" Background="White">
                    <TabItem Header="Payment Notes Details" Style="{DynamicResource TabItemStyle}" Height="39">
                        <AdornerDecorator>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="400"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="CompanyDetails" Grid.Row="0"
                                    Orientation="Vertical">
                                    <TextBlock Text="Select Sevice"
                                       Style="{StaticResource FormTextBlock}"
                                       Margin="20,20,230,0"/>

                                    <ComboBox Style="{StaticResource vendorCombobox}"                              
                                              ItemsSource="{Binding Path=ComboItem}"   
                                              SelectedItem="{Binding Path=SelectComboItem}"  
                                              DisplayMemberPath="NameSearch"  
                                              Name="VendorServices" 
                                              Grid.Row="1" 
                                              Width="239" 
                                              Height="30" 
                                              VerticalContentAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Margin="0,-20,10,25"
                                              Background="Transparent"
                                              FontWeight="Medium"
                                              FontFamily="Montserrat"                            
                                              Foreground="{StaticResource plainTextColor3}"
                                              BorderBrush="{StaticResource plainTextColor3}"
                                              BorderThickness="0,0,0,1" />
                                    <TextBlock Text="Select Payment Code"
                                               Style="{StaticResource FormTextBlock}"
                                               Margin="20,20,230,0"/>
                                    <ComboBox Style="{StaticResource vendorCombobox}"                              
                                              ItemsSource="{Binding Path=ComboItem}"   
                                              SelectedItem="{Binding Path=SelectComboItem}"  
                                              DisplayMemberPath="NameSearch"  
                                              Name="PaymentCode" 
                                              Grid.Row="1" 
                                              Width="239" 
                                              Height="30" 
                                              VerticalContentAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Margin="0,-20,10,25"
                                              Background="Transparent"
                                              FontWeight="Medium"
                                              FontFamily="Montserrat"                            
                                              Foreground="{StaticResource plainTextColor3}"
                                              BorderBrush="{StaticResource plainTextColor3}"
                                              BorderThickness="0,0,0,1" />


                                    <TextBlock Text="Payment Note Number"
                                        Style="{StaticResource FormTextBlock}"/>

                                    <TextBox x:Name="txtPaymentNoteNo"
                                     Text="{Binding VendorName ,UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormTextBox}"/>

                                    <TextBlock Text="Payment Note Date"
                                       Style="{StaticResource FormTextBlock}"/>

                                    <DatePicker Name="paymentNoteDate"></DatePicker>

                                </StackPanel>

                                <StackPanel x:Name="CompanyDetail2" Grid.Column="1"
                                       Orientation="Vertical">
                                   

                                </StackPanel>

                            </Grid>
                        </AdornerDecorator>
                    </TabItem>

                    <TabItem Header="Invoice Details" Style="{DynamicResource TabItemStyle}" Height="39">
                        <AdornerDecorator>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400"/>
                                    <ColumnDefinition Width="400"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="CompanyGSTAndBankDetails" 
                                    Grid.Row="0"
                                    Orientation="Vertical">
                                    <TextBlock Text="Invoice Number"
                                       Style="{StaticResource FormTextBlock}"
                                       Margin="20,20,0,0"/>

                                    <TextBox x:Name="txtVendorPan"
                                       Text="{Binding VendorPAN,UpdateSourceTrigger=PropertyChanged}"                                         
                                       Style="{StaticResource FormTextBox}"/>

                                    <TextBlock Text="Invoice Date"
                                       Style="{StaticResource FormTextBlock}"
                                       Margin="20,20,0,0"/>

                                    <TextBox x:Name="txtVendorBankName"
                                       Text="{Binding VendorBankName ,UpdateSourceTrigger=PropertyChanged}"                                         
                                       Style="{StaticResource FormTextBox}"/>

                                    <TextBlock Text="Invoice Particular"
                                       Style="{StaticResource FormTextBlock}"/>

                                    <TextBox x:Name="txtVendorAccountNumber"
                                       Text="{Binding VendorAccountNumber ,UpdateSourceTrigger=PropertyChanged}"                                         
                                      Style="{StaticResource FormTextBox}"/>



                                </StackPanel>
                                <StackPanel x:Name="CompanyDetai" Grid.Column="1"
                                    Orientation="Vertical"/>
                            </Grid>
                        </AdornerDecorator>
                    </TabItem>
                </TabControl>
            </Grid>

            <!--buttons setting in footer-->
            <StackPanel Grid.Row="2" 
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,9">
                <Button Command="{Binding BackCommand}" Style="{StaticResource gridEditButton}">
                    <iconPacks:PackIconMaterial Kind="LessThan" Width="12" Height="12" VerticalAlignment="Center" />
                </Button>
                <Button Style="{StaticResource vendorSaveButton}"
                    Command="{Binding SubmitCommand}"                            
                    Content="{Binding SaveButtonName, Mode=TwoWay}"                            
                    FontSize="12"
                    FontFamily="Montserrat"
                    Cursor="Hand"
                    BorderThickness="0"
                    Foreground="White"
                    VerticalAlignment="Top"/>
                <Button Style="{StaticResource vendorCancelButton}"
                    Command="{Binding HideVendorFormCommand}"                            
                    Content="Cancel"                            
                    FontSize="12"
                    FontFamily="Montserrat"
                    Cursor="Hand"
                    BorderThickness="0"
                    Foreground="White"
                    VerticalAlignment="Top"/>
                <Button Style="{StaticResource vendorClearButton}"
                    Command="{Binding ClearFormCommand }"                            
                    Content="Clear"                            
                    FontSize="12"
                    FontFamily="Montserrat"
                    Cursor="Hand"
                    BorderThickness="0"
                    Foreground="White"
                    VerticalAlignment="Top"/>
                <Button Command="{Binding NextCommand}" Margin="4" Style="{StaticResource gridEditButton}">
                    <iconPacks:PackIconMaterial Kind="GreaterThan" Width="12" Height="12" VerticalAlignment="Center" />
                </Button>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
