<UserControl x:Class="VMA.MVVM.Views.Add.AddUpdatePaymentNotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:add="clr-namespace:VMA.MVVM.ViewModels.Add" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" d:DataContext="{d:DesignInstance Type=add:AddPaymentNotesViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="10"                    
    BorderThickness="0"
        Background="white" Opacity="0.95">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="410"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TabControl Style="{DynamicResource TabContorlStyle}" Background="White">
                    <TabItem Header="Payment Notes Details" Style="{DynamicResource TabItemStyle}" Height="39">
                        <AdornerDecorator>
                            
                                <StackPanel x:Name="CompanyDetails"
                                    Orientation="Vertical">
                                <Grid Grid.Row="0" ShowGridLines="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="50"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Payment Note Year"
                                               Style="{StaticResource FormTextBlock}" Grid.Column="0" Grid.Row="0"/>

                                    <TextBox x:Name="txtServiceYear"
                                               Text="{Binding PaymentNoteYear ,UpdateSourceTrigger=PropertyChanged}"
                                               Style="{StaticResource FormTextBox}"
                                               TextWrapping="Wrap" Grid.Column="1" Grid.Row="0"
                                               AcceptsReturn="True" IsEnabled="False"/>

                                    <TextBlock Text="Select Vendor" VerticalAlignment="Center"
                                               Style="{StaticResource FormTextBlock}" Grid.Column="0" Grid.Row="1"/>
                                    <ComboBox Style="{StaticResource vendorCombobox}"                              
                                              Visibility="{Binding HideVendorSelectComboBox}"
                                              ItemsSource="{Binding VendorModels}"   
                                              SelectedItem="{Binding SelectedVendorModel, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                                              DisplayMemberPath="VendorName" 
                                              SelectedValuePath="VendorId"
                                              SelectedValue="{Binding SelectedVendorDetailService.VendorId, Mode=TwoWay}"
                                              Width="239" 
                                              Height="30" 
                                              VerticalContentAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Background="Transparent"
                                              FontWeight="Medium"
                                              FontFamily="Montserrat"                            
                                              Foreground="{StaticResource plainTextColor3}"
                                              BorderBrush="{StaticResource plainTextColor3}"
                                              BorderThickness="0,0,0,1" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1"/>
                                    <TextBox x:Name="txtBoxVendor"   Grid.Column="1" Grid.Row="1"
                                             Text="{Binding SelectedVendorName ,UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding HideSelectedVendor}"
                                             IsEnabled="False"
                                             Style="{StaticResource FormTextBox}"/>
                                    <!--<TextBlock Text="Select Sevice"
                                       Style="{StaticResource FormTextBlock}"
                                       Margin="20,20,230,0"/>-->

                                    <!--<ComboBox Style="{StaticResource vendorCombobox}"                              
                                              Visibility="{Binding HideServiceSelectComboBox}"
                                              ItemsSource="{Binding VendorServiceDetails}"   
                                              SelectedItem="{Binding SelectedVendorDetailService, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"  
                                              DisplayMemberPath="VendorServiceName" 
                                              SelectedValuePath="VendorServiceId"
                                              SelectedValue="{Binding SelectedVendorDetailService.VendorServiceId, Mode=TwoWay}"
                                              Grid.Row="1" 
                                              Width="239" 
                                              Height="30" 
                                              VerticalContentAlignment="Center"
                                              HorizontalAlignment="Right"
                                              Margin="0,-20,10,40"
                                              Background="Transparent"
                                              FontWeight="Medium"
                                              FontFamily="Montserrat"                            
                                              Foreground="{StaticResource plainTextColor3}"
                                              BorderBrush="{StaticResource plainTextColor3}"
                                              BorderThickness="0,0,0,1" />
                                    <TextBox x:Name="txtVendorService"
                                             Text="{Binding SelctedVendorServiceName ,UpdateSourceTrigger=PropertyChanged}"
                                             Visibility="{Binding HideSelectedService}"
                                             IsEnabled="False"
                                             Style="{StaticResource FormTextBox}"
                                              />-->

                                    <TextBlock Text="Payment Note Number" Grid.Column="0" Grid.Row="2"
                                               Style="{StaticResource FormTextBlock}"/>
                                    
                                    <TextBlock Text="{Binding PaymentNoteId,UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" Grid.Row="2"
                                               FontSize="13" Visibility="Hidden"  FontWeight="DemiBold"  Style="{StaticResource FormTextBlock}"/>

                                    <TextBox x:Name="txtPaymentNoteNo" Grid.Column="1" Grid.Row="2" Padding="0"
                                             Text="{Binding PaymentNoteNo ,UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBox}" 
                                             IsEnabled="False"/>

                                    <TextBlock Text="Payment Note Date" Grid.Column="0" Grid.Row="3"
                                               Style="{StaticResource FormTextBlock}"/>

                                    <DatePicker Name="paymentNoteDate" Grid.Column="1" Grid.Row="3" HorizontalAlignment="Left"
                                                Text="{Binding  PaymentNoteDate ,UpdateSourceTrigger=LostFocus,Mode=TwoWay}" Height="29" Width="250"/>



                                </Grid>

                            </StackPanel>
                        </AdornerDecorator>
                    </TabItem>
                </TabControl>
            </Grid>

            <!--buttons setting in footer-->
            <StackPanel Grid.Row="2" 
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,9">
              
                <Button Style="{StaticResource vendorSaveButton}"
                    Command="{Binding SubmitCommand}"                            
                    Content="{Binding SaveButtonName, Mode=TwoWay}"                            
                    FontSize="12"
                    FontFamily="Montserrat"
                    Cursor="Hand"
                    BorderThickness="0"
                    Foreground="White"
                    VerticalAlignment="Top"/>
                <Button Style="{StaticResource vendorCancelButton}"
                    Command="{Binding HidePaymentNotesFormCommand}"                            
                    Content="Cancel"                            
                    FontSize="12"
                    FontFamily="Montserrat"
                    Cursor="Hand"
                    BorderThickness="0"
                    Foreground="White"
                    VerticalAlignment="Top"/>
                <Button Style="{StaticResource vendorClearButton}"
                    Command="{Binding ClearFormCommand }"                            
                    Content="Clear"                            
                    FontSize="12"
                    FontFamily="Montserrat"
                    Cursor="Hand"
                    BorderThickness="0"
                    Foreground="White"
                    VerticalAlignment="Top"/>
                

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
