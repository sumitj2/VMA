<UserControl x:Class="VMA.MVVM.Views.Add.AddUpdateVendorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VMA.MVVM.Views.Add" xmlns:add="clr-namespace:VMA.MVVM.ViewModels.Add" d:DataContext="{d:DesignInstance Type=add:AddUpdateVendorViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Border CornerRadius="10"                    
        BorderThickness="0"
            Background="{StaticResource panelColor}" Opacity="0.95">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource winBorderColor1}" Offset="0"/>
                <GradientStop Color="{StaticResource winBorderColor2}" Offset="0.5"/>
                <GradientStop Color="{StaticResource winBorderColor3}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="410"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <TabControl Background="{StaticResource panelColor}">
                    <TabItem Header="Contact Inforamtion">
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="400"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="CompanyDetails" Grid.Row="0"
                                        Orientation="Vertical">
                                <TextBlock Text="Vendor Code"
                                           Style="{StaticResource FormTextBlock}"
                                           Margin="20,20,230,0"/>

                                <TextBox x:Name="txtVendorCode"
                                         Text="{Binding VendorCode ,UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBox}"/>

                                <TextBlock Text="Vendor Name"
                                            Style="{StaticResource FormTextBlock}"/>

                                <TextBox x:Name="txtVendorName"
                                         Text="{Binding VendorName ,UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource FormTextBox}"/>

                                <TextBlock Text="Vendor Address"
                                           Style="{StaticResource FormTextBlock}"/>

                                <TextBox x:Name="txtVendorAddress"
                                         Text="{Binding VendorAddress ,UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource FormTextBox}"
                                            Height="54" TextWrapping="Wrap"
                                            AcceptsReturn="True"/>

                                <TextBlock Text="Vendor Pin-Code"
                                           Style="{StaticResource FormTextBlock}"/>

                                <TextBox x:Name="txtVendorPinCode"
                                         Text="{Binding VendorPinCode ,UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource FormTextBox}"/>

                            </StackPanel>

                            <StackPanel x:Name="CompanyDetail2" Grid.Column="1"
                                           Orientation="Vertical">
                                <TextBlock Text="Phone Number"
                                           Style="{StaticResource FormTextBlock}"
                                            Margin="20,20,230,0"/>

                                <TextBox x:Name="txtVendorPhoneNo"
                                           Text="{Binding VendorPhoneNo ,UpdateSourceTrigger=PropertyChanged}"                                         
                                            Style="{StaticResource FormTextBox}"/>
                                
                                <TextBlock Text="Vendor Email Id"
                                            Style="{StaticResource FormTextBlock}"/>
                               
                                <TextBox x:Name="txtVendorEmailId"
                                           Text="{Binding VendorEmailId,UpdateSourceTrigger=PropertyChanged}"                                         
                                           Style="{StaticResource FormTextBox}"/>

                            </StackPanel>

                        </Grid>
                    </TabItem>
                    <TabItem Header="Bank and GST Details" Style="{StaticResource TabItemStyle}">
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="400"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="CompanyGSTAndBankDetails" 
                                        Grid.Row="0"
                                        Orientation="Vertical">
                                <TextBlock Text="Account Number"
                                           Style="{StaticResource FormTextBlock}"
                                           Margin="20,20,0,0"/>
                                
                                <TextBox x:Name="txtVendorAccountNumber"
                                           Text="{Binding VendorAccountNumber ,UpdateSourceTrigger=PropertyChanged}"                                         
                                          Style="{StaticResource FormTextBox}"/>
                                
                                <TextBlock Text="Bank IFSC Code"
                                           Style="{StaticResource FormTextBlock}"/>
                                
                                <TextBox x:Name="txtVendorIFSCCode"
                                           Text="{Binding VendorIfsccode ,UpdateSourceTrigger=PropertyChanged}"                                         
                                            Style="{StaticResource FormTextBox}"/>
                                
                                <TextBlock Text="GTS Number"                                           
                                           Style="{StaticResource FormTextBlock}"/>
                                
                                <TextBox x:Name="txtVendorGSTNumber"
                                           Text="{Binding VendorGstnumber ,UpdateSourceTrigger=PropertyChanged}"                                         
                                           Style="{StaticResource FormTextBox}"/>


                            </StackPanel>
                        </Grid>

                    </TabItem>


                </TabControl>
            </Grid>
            <!--buttons setting in footer-->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,9">
                <Button Style="{StaticResource vendorSaveButton}"
                        Command="{Binding SubmitCommand}"                            
                        Content="Save"                            
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        BorderThickness="0"
                        Foreground="White"
                        VerticalAlignment="Top"/>
                <Button Style="{StaticResource vendorCancelButton}"
                        Command="{Binding HideVendorFormCommand}"                            
                        Content="Cancel"                            
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        BorderThickness="0"
                        Foreground="White"
                        VerticalAlignment="Top"/>
                <Button Style="{StaticResource vendorClearButton}"
                        Command="{Binding }"                            
                        Content="Clear"                            
                        FontSize="12"
                        FontFamily="Montserrat"
                        Cursor="Hand"
                        BorderThickness="0"
                        Foreground="White"
                        VerticalAlignment="Top"/>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
